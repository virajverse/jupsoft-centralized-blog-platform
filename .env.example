# ==============================================================================
# Jupsoft Centralized Multi-Site Blog Platform — Master Environment Configuration Template
# Copy this file to .env and replace placeholders with secure production/local credentials.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Platform Network Architecture
# ------------------------------------------------------------------------------
PORT=4010
ADMIN_PORT=3000
NODE_ENV=development
PLATFORM_BASE_URL=http://localhost:4010
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4010,https://blogary.jupsoft.com

# ------------------------------------------------------------------------------
# 2. Next.js Frontend Public Configuration (Auto-baked at build time)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4010
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_API_PORT=4010

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database (Prisma)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:password@localhost:5432/jupsoft_cms?schema=public
DIRECT_URL=postgresql://postgres:password@localhost:5432/jupsoft_cms?schema=public
LOCAL_DATABASE_URL=postgresql://postgres:password@localhost:5432/jupsoft_cms?schema=public
SYNC_CRON_SCHEDULE="0 */2 * * *"

# ------------------------------------------------------------------------------
# 4. Supabase Cloud Configuration (Optional if using self-hosted PostgreSQL)
# ------------------------------------------------------------------------------
SUPABASE_PROJECT_REF=
SUPABASE_PROJECT_NAME=
SUPABASE_URL=
SUPABASE_REGION=
SUPABASE_DB_PASSWORD=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 5. Redis Caching & Distributed Rate Limiting (L1 In-Memory + L2 Redis)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 6. Enterprise JWT Authentication & Session Lifetime
# ------------------------------------------------------------------------------
# Minimum 32-character random string (e.g. openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_key_min_32_characters_here
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_min_32_characters_here
JWT_REFRESH_EXPIRATION=7d

# ------------------------------------------------------------------------------
# 7. AWS S3 Storage & CloudFront Global CDN (TRD Section 10 & 18)
# ------------------------------------------------------------------------------
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=your_s3_bucket_name
CLOUDFRONT_DOMAIN=https://your-cdn-domain.com

# ------------------------------------------------------------------------------
# 8. Webhook Invalidation Secret (HMAC SHA-256 for Tenant ISR)
# ------------------------------------------------------------------------------
WEBHOOK_DEFAULT_SECRET=your_webhook_invalidation_secret_here

# ------------------------------------------------------------------------------
# 9. Google OAuth 2.0 Single Sign-On (Audience Verification)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=

# ------------------------------------------------------------------------------
# 10. AWS SES Transactional Email (Password Reset, Editorial Approvals)
# ------------------------------------------------------------------------------
AWS_SES_REGION=ap-south-1
AWS_SES_ACCESS_KEY_ID=your_aws_ses_access_key_id
AWS_SES_SECRET_ACCESS_KEY=your_aws_ses_secret_access_key
SES_FROM_EMAIL=noreply@jupsoft.com
