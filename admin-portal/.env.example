# Jupsoft Blog CMS Admin Portal Environment Variables
# In production with reverse proxy (Nginx), you can leave NEXT_PUBLIC_API_URL empty
# and apiClient will automatically connect to window.location.origin.
#
# For local dev where Next.js runs on :3000 and NestJS runs on :4010:
# NEXT_PUBLIC_API_PORT=4010
#
# To explicitly direct traffic to an external API gateway:
# NEXT_PUBLIC_API_URL=https://api.cms.jupsoft.com

NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_API_PORT=4010
