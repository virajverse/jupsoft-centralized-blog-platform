# Server
PORT=4000
NODE_ENV=development
PLATFORM_BASE_URL=http://localhost:4000

# PostgreSQL Database (Prisma)
DATABASE_URL=postgresql://postgres:viraj@localhost:5432/jupsoft_cms?schema=public

# Redis Caching & Rate Limiting
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET=jupsoft_enterprise_jwt_super_secret_key_2026
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=jupsoft_enterprise_refresh_super_secret_key_2026
JWT_REFRESH_EXPIRATION=30d

# AWS S3 & CloudFront (TRD Section 10 & 18)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=mock_aws_access_key
AWS_SECRET_ACCESS_KEY=mock_aws_secret_key
AWS_S3_BUCKET=jupsoft-blogs-storage
CLOUDFRONT_DOMAIN=http://localhost:4000/uploads

# Webhook Revalidation Secret (HMAC SHA-256)
WEBHOOK_DEFAULT_SECRET=wh_sec_jupsoft_default_revalidate_2026

# CORS Allowed Origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5001,http://localhost:5002,http://localhost:5003
