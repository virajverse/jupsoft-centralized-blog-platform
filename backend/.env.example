# Server
PORT=4000
NODE_ENV=production
PLATFORM_BASE_URL=https://api.cms.jupsoft.com
ALLOWED_ORIGINS=https://cms.jupsoft.com,https://api.cms.jupsoft.com,https://cloud.jupsoft.com,https://jupsoft.com,https://digifynext.com,https://schoolerp.in

# PostgreSQL Database (Prisma)
DATABASE_URL=postgresql://jupsoft_admin:jupsoft_secret_2026@localhost:5432/jupsoft_cms?schema=public

# Redis Caching & Rate Limiting
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication (FIX 1: Remove fallback — MUST be set in production)
# JWT_SECRET must be a random 64+ char string generated with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_STRONG_SECRET_MIN_32_CHARS
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_STRONG_SECRET_MIN_32_CHARS
JWT_REFRESH_EXPIRATION=30d

# AWS S3 & CloudFront (TRD Section 10 & 18)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=jupsoft-blogs-storage
CLOUDFRONT_DOMAIN=https://cdn.jupsoft.com

# AWS SES Email Service (TRD Editorial Workflow Notifications)
AWS_SES_REGION=ap-south-1
SES_FROM_EMAIL=noreply@jupsoft.com

# AWS CloudWatch Structured Logging & Metric Filters (TRD Section 18)
CLOUDWATCH_LOG_GROUP=/ecs/jupsoft-blog-backend
CLOUDWATCH_LOG_STREAM=backend-instance

# Webhook Revalidation Secret (HMAC SHA-256) — FIX 2: MUST be set, no fallback
# Generate with: openssl rand -hex 32
WEBHOOK_DEFAULT_SECRET=REPLACE_WITH_STRONG_WEBHOOK_SECRET

# Swagger API key — only needed in production to gate /api/docs access
# Leave empty in development (docs always available)
SWAGGER_API_KEY=REPLACE_WITH_SWAGGER_ACCESS_KEY_FOR_PRODUCTION

# Google OAuth Sign-In (Optional audience verification for Google SSO)
# Must match the Client ID configured in Google Cloud Console
GOOGLE_CLIENT_ID=

