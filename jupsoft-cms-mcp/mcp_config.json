{
  "mcpServers": {
    "jupsoft-cms-admin": {
      "command": "python",
      "args": [
        "-m",
        "jupsoft_cms.server"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1",
        "PYTHONPATH": "src",
        "CMS_API_BASE": "https://blogary.jupsoft.com",
        "CMS_ADMIN_EMAIL": "superadmin@jupsoft.com",
        "CMS_ADMIN_PASSWORD": "${CMS_ADMIN_PASSWORD}"
      }
    }
  }
}
